NEXT_PUBLIC_APP_URL=https://awamenu.com

# ─── Database (Neon) ──────────────────────────────────
# Neon suspends idle compute. The first query has to wake it, which can take
# longer than Prisma's 5s default and surfaces as "Can't reach database server".
DATABASE_URL=postgresql://...?sslmode=require&connect_timeout=15&pool_timeout=15
# Direct (non-pooled) Neon host — the pooled host without "-pooler". Used only by
# prisma migrate (Neon's pooler can't hold migrate's session lock). Required in
# Vercel production: deployments run `prisma migrate deploy` before building.
DIRECT_DATABASE_URL=postgresql://...?sslmode=require

# ─── Redis (Upstash) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── Auth (better-auth) ───────────────────────────────
BETTER_AUTH_SECRET=...
BETTER_AUTH_URL=https://awamenu.com

# ─── Payments (Paystack) ──────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
# Leave out. Paystack has no separate webhook secret: it signs webhooks with
# PAYSTACK_SECRET_KEY (sk_…). NEVER put the public key (pk_…) here; it's public,
# so anyone could sign fake webhooks with it (it's now ignored if you do).
# AwaMenu doesn't rely on webhooks anyway (the account's one webhook URL may
# belong to another app): payments are confirmed with Paystack directly by the
# return page and /api/cron/payments. See lib/payment-attempts.ts.
# PAYSTACK_WEBHOOK_SECRET=

# ─── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=re_...
# Order confirmations only.
RESEND_FROM_EMAIL=orders@awamenu.com
# Signup/verification, welcome, billing, and subscription emails.
RESEND_ACCOUNTS_FROM_EMAIL=hello@awamenu.com

# ─── WhatsApp (Twilio) ────────────────────────────────
# If AwaMenu runs in its own Twilio subaccount (recommended — one WhatsApp
# Business Account is allowed per account/subaccount), every value below must
# come from that subaccount: its SID, its token, its numbers, its templates.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=+14155238886   # Order updates + login codes over WhatsApp
TWILIO_SMS_FROM=+1...                # Order updates + login codes over SMS
# Approved WhatsApp template Content SIDs (JSON, keyed by message). Required for
# WhatsApp in production — see docs/whatsapp-templates.md.
TWILIO_WHATSAPP_TEMPLATES=
# "true" only with Twilio's WhatsApp sandbox. Never in production.
TWILIO_WHATSAPP_ALLOW_FREEFORM=

# ─── Storage (Cloudinary) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
NEXT_PUBLIC_CLOUDINARY_DELIVERY_URL=https://res.cloudinary.com/your-cloud-name

# ─── QStash (Upstash) — reservation auto-expiry ──────
QSTASH_TOKEN=qstash_...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# ─── Web Push (VAPID) ─────────────────────────────────
# Generate with: bunx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...   # Public — safe to expose to browser
VAPID_PRIVATE_KEY=...              # Private — server only, never expose
VAPID_EMAIL=admin@awamenu.com      # Contact email for VAPID

# ─── Sentry ───────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...
SENTRY_ORG=...
SENTRY_PROJECT=...

# ─── Analytics (PostHog) ─────────────────────────────
# Project API key (Project settings → Project API key). Public by design: used
# by the browser for page views and by the server for business events.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Ingestion host (sending events), with ".i.": https://eu.i.posthog.com for
# EU Cloud, https://us.i.posthog.com for US Cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional: send server events to a different project than the browser.
# POSTHOG_PROJECT_API_KEY=phc_...

# Reading analytics back for Super Admin → Analytics → Traffic.
# Personal API key (Account settings → Personal API keys): only the
# "Query: Read" scope, limited to this project. Keep it secret.
POSTHOG_PERSONAL_API_KEY=phx_...
# Project id: the number in your PostHog URL (/project/12345).
POSTHOG_PROJECT_ID=12345
# App host for reading data, without ".i.", in the SAME region as above:
# https://eu.posthog.com (EU) or https://us.posthog.com (US). Optional: if
# left out it's worked out from NEXT_PUBLIC_POSTHOG_HOST.
POSTHOG_API_HOST=https://eu.posthog.com

# ─── Cloudflare (Turnstile) ───────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=...
TURNSTILE_SECRET_KEY=...

# ─── Super Admin ──────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@awamenu.com

# ─── Cron ─────────────────────────────────────────────
# Shared secret for external schedulers (cron-jobs.org, Vercel Cron).
# Minimum 16 characters. Sent as `Authorization: Bearer <value>`.
CRON_SECRET=...
# Schedule on cron-job.org (header: Authorization: Bearer <CRON_SECRET>):
#   GET /api/cron/payments            every 5 min   confirm pending payments
#   GET /api/cron/reservations        every 10 min  release unpaid holds, no-shows
#   GET /api/cron/subscriptions       daily         renewals and expiry notices
#   GET /api/cron/reconcile-payments  daily 01:00   compare ledger with Paystack

# ─── Feature Flags ────────────────────────────────────
SKIP_ENV_VALIDATION=   # "true" in CI only

# ─── Monnify (AwaMenu Pay alternative provider) ───────
# Sandbox: https://sandbox.monnify.com   Live: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=...
MONNIFY_SECRET_KEY=...
MONNIFY_CONTRACT_CODE=...
