// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────

enum UserRole {
  RESTAURANT_OWNER
  SUPER_ADMIN
}

enum PlanTier {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum OnboardingStatus {
  PENDING_PLAN
  PENDING_PAYMENT
  PENDING_SETUP
  COMPLETE
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
  TABLE_RESERVATION
}

enum OrderStatus {
  PENDING_APPROVAL
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DineInPaymentMethod {
  CASH
  TRANSFER_OR_CARD
}

enum PaymentMethod {
  CASH
  POS
  TRANSFER
  PAYSTACK
}

enum DineInServiceMode {
  SELF_SERVED
  SERVED_BY_WAITER
}

enum PaymentPolicy {
  PAY_BEFORE_SERVICE
  PAY_AFTER_SERVICE
  FLEXIBLE
}

/// How a restaurant sends order updates to its customers.
///
/// The message always goes out on AwaMenu's Twilio sender with the
/// restaurant's name in the body: Twilio permits one WhatsApp Business
/// Account per (sub)account, so a sender per restaurant would mean a Twilio
/// subaccount and Meta business verification each. `whatsappNumber` on
/// Restaurant is unrelated — that stays the number staff/admin open wa.me
/// links against.
enum CustomerUpdateChannel {
  WHATSAPP
  SMS
  NONE
}

enum ReservationStatus {
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  CHECKED_IN
  COMPLETED
  EXPIRED
  CANCELLED
  DECLINED
}

// ─── Table Booking Configuration Enums ───────────────

enum TableBookingMode {
  FREE_BOOKING
  ORDER_REQUIRED
  DEPOSIT_REQUIRED
  FULL_PAYMENT
}

enum TablePaymentTiming {
  PAY_ON_BOOKING
  PAY_ON_ARRIVAL
  PAY_AFTER_SERVICE
}

enum TableInclusionType {
  TABLE_FEE_ONLY
  FOOD_ONLY
  FOOD_AND_TABLE_FEE
}

enum RatingContext {
  DINE_IN
  DELIVERY
  PICKUP
  RESERVATION
}

// ─── Notification Enums ───────────────────────────────

// Who the notification is for

enum NotificationAudience {
  ADMIN // Restaurant owner / dashboard users
  STAFF // Staff members of the restaurant
  BOTH // Sent to both admin and staff
}

// What triggered the notification

enum NotificationType {
  NEW_ORDER // A new order was placed (any type)
  ORDER_STATUS_CHANGED // Admin/staff updated an order's status
  ORDER_CANCELLED // An order was cancelled
  NEW_RESERVATION // A customer booked a table
  RESERVATION_CANCELLED // A reservation was cancelled
  RESERVATION_EXPIRED // QStash fired expiry — table freed
  PAYMENT_RECEIVED // Staff recorded a dine-in payment
  LOW_STOCK_ALERT // (future) menu item stock low
}

// ─── Auth (better-auth managed) ──────────────────────

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  emailVerified    Boolean  @default(false)
  name             String?
  image            String?
  role             UserRole @default(RESTAURANT_OWNER)
  isActive         Boolean  @default(true)
  suspensionReason String?

  onboardingStatus OnboardingStatus @default(PENDING_PLAN)

  restaurants       Restaurant[]
  sessions          Session[]
  accounts          Account[]
  subscriptions     Subscription[]
  pushSubscriptions PushSubscription[] // VAPID Web Push subscriptions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  provider              String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([provider, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Staff Accounts ───────────────────────────────────

model StaffMember {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name     String
  staffId  String  @unique
  isActive Boolean @default(true)

  // Per-staff permission overrides (null = inherit restaurant default)
  canHandleDineIn        Boolean?
  canHandlePickup        Boolean?
  canHandleDelivery      Boolean?
  canRecordCashPayment   Boolean?
  canApproveReservations Boolean?

  orders            Order[]            @relation("AttendingStaff")
  pushSubscriptions PushSubscription[] // VAPID Web Push subscriptions for staff
  orderEvents       OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([staffId])
}

// ─── Subscription Plans ───────────────────────────────

model Plan {
  id          String   @id @default(cuid())
  tier        PlanTier @unique
  name        String
  description String?

  monthlyPrice   Decimal @default(0) @db.Decimal(10, 2)
  quarterlyPrice Decimal @default(0) @db.Decimal(10, 2)
  yearlyPrice    Decimal @default(0) @db.Decimal(10, 2)

  maxCategories Int @default(1)
  /// Tables a restaurant may create for reservations. -1 is unlimited,
  /// matching maxCategories/maxMenuItems so the resolver treats all three
  /// limits identically.
  maxTables     Int @default(1)
  maxMenuItems  Int @default(8)

  advancedAnalytics     Boolean @default(false)
  removeAwamenuBranding Boolean @default(false)
  whatsappIntegration   Boolean @default(true)
  prioritySupport       Boolean @default(false)
  basicSupport          Boolean @default(false)

  // Sole source of truth for menu-layout entitlement. A plan grants exactly
  // the layouts listed here; "classic" is always re-added by the resolver, so
  // a plan can never end up with none. (Replaces the former
  // `multipleTemplates` boolean, which duplicated what this already encodes
  // and could contradict it.)
  availableTemplates String[] @default(["classic"])

  paystackPlanCode          String? // Legacy monthly Paystack subscription plan code.
  paystackMonthlyPlanCode   String?
  paystackQuarterlyPlanCode String?
  paystackYearlyPlanCode    String?

  isActive Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Subscriptions ────────────────────────────────────

model Subscription {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  planId         String
  plan           Plan    @relation(fields: [planId], references: [id])
  originalPlanId String?

  status          SubscriptionStatus @default(TRIALING)
  billingInterval BillingInterval    @default(MONTHLY)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  paystackSubscriptionCode String?
  paystackCustomerCode     String?
  paymentRef               String?

  // Furthest expiry notice already sent for the *current* period ("T7", "T3",
  // "T0", "SUSPENDED"). Makes the reminder cron idempotent: without it, every
  // run inside the same day would re-send, and a schedule that fires more than
  // once a day would spam owners. Cleared whenever a payment starts a new
  // period.
  lastExpiryNoticeStage String?

  restaurantId String?     @unique
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([restaurantId])
}

// ─── Restaurant (Tenant) ──────────────────────────────

model Restaurant {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  logoUrl     String?
  coverUrl    String?
  phone       String?
  address     String?
  currency    String  @default("NGN")
  timezone    String  @default("Africa/Lagos")

  whatsappNumber String?

  /// Channel for automatic order updates to customers. Defaults to WhatsApp,
  /// which falls back to nothing being sent until the platform's Twilio
  /// credentials exist — never to an unexpected SMS bill.
  customerUpdateChannel CustomerUpdateChannel @default(WHATSAPP)

  /// Collapsed rather than deleted — someone who dismissed the setup list in
  /// week one still needs to find it in week three, and from any device, so
  /// this lives on the record rather than in localStorage.
  setupChecklistDismissedAt DateTime?

  dineInEnabled           Boolean @default(true)
  pickupEnabled           Boolean @default(true)
  deliveryEnabled         Boolean @default(true)
  tableReservationEnabled Boolean @default(false)
  tablesEnabled           Boolean @default(false)

  dineInPaymentPolicy PaymentPolicy @default(PAY_BEFORE_SERVICE)

  // ─── Staff Permission Defaults ──────────────────────
  // Global defaults for all staff. Individual staff can override.
  staffDefaultDineIn              Boolean @default(true)
  staffDefaultPickup              Boolean @default(false)
  staffDefaultDelivery            Boolean @default(false)
  staffDefaultCashPayment         Boolean @default(true)
  staffDefaultApproveReservations Boolean @default(false)

  staffDashboardPassword      String? // Master password for the shared staff dashboard
  staffDashboardAutoLockHours Int     @default(24) // Hours before session auto-locks

  isActive Boolean @default(true)

  primaryColor   String?
  fontFamily     String?
  activeTemplate String  @default("classic")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  subscription       Subscription?
  categories         MenuCategory[]
  banners            RestaurantBanner[]
  orders             Order[]
  tables             TableSeat[]
  reservations       Reservation[]
  reservationSetting ReservationSetting?
  analytics          ScanEvent[]
  staff              StaffMember[]
  ratings            Rating[]
  notifications      Notification[] // All notifications for this restaurant
  bankAccounts       RestaurantBankAccount[]
  paymentMethods     RestaurantPaymentMethod[]
  payoutAccounts     RestaurantPayoutAccount[]
  openingHours       RestaurantOpeningHour[]
  blackoutDates      RestaurantBlackoutDate[]
  payments           OrderPayment[]
  auditEvents        RestaurantAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([ownerId])
}

// ─── Payments ─────────────────────────────────────────

enum PaymentChannel {
  AWAMENU_PAY // Online payment routed through AwaMenu's provider, settled
  //             direct to the restaurant via a provider subaccount.
  OWN_GATEWAY // Restaurant's own provider account and API keys.
  BANK_TRANSFER // Manual — account details shown to the customer.
  CASH // Manual — paid in person.
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  MONNIFY
}

/// One row per (restaurant, channel). Channels are toggled independently, so a
/// restaurant can run AwaMenu Pay and cash together. Modelled as rows rather
/// than columns on Restaurant so adding a channel or provider later needs no
/// migration.
model RestaurantPaymentMethod {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  channel   PaymentChannel
  isEnabled Boolean        @default(false)
  sortOrder Int            @default(0)

  /// For AWAMENU_PAY: which platform provider created the subaccount.
  /// For OWN_GATEWAY: which provider the restaurant connected.
  gateway PaymentGateway?

  // ─── OWN_GATEWAY credentials ───
  publicKey          String?
  /// Encrypted at rest (see lib/secret-box.ts) — a live secret key is the most
  /// sensitive value this app stores, and it must never reach the browser.
  secretKeyEncrypted String?
  /// Monnify additionally requires a contract code alongside the key pair.
  contractCode       String?
  lastVerifiedAt     DateTime?

  // ─── Bank details ───
  // Used by AWAMENU_PAY (to create the provider subaccount) and by
  // BANK_TRANSFER (shown to the customer). Always resolved through the
  // provider's account-lookup API rather than typed, so the name is verified.
  bankCode      String?
  bankName      String?
  accountNumber String?
  accountName   String?

  /// Provider-side subaccount identifier for AWAMENU_PAY.
  subaccountCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, channel])
  @@index([restaurantId])
}

/// A restaurant's settlement account at one AwaMenu Pay provider.
///
/// Separate from RestaurantPaymentMethod because AwaMenu Pay is not one
/// connection: a restaurant may run Paystack, Monnify, or both at once, and a
/// subaccount only exists at the provider that created it. Bank codes are
/// provider-specific too, so each row stores the code as that provider issued
/// it — a Paystack code is not valid at Monnify.
/// One opening period. A day can have several — a kitchen that closes between
/// lunch and dinner needs two rows for the same weekday, which a single
/// open/close pair per day cannot express.
///
/// Times are stored as "HH:mm" in the restaurant's own timezone rather than as
/// timestamps: opening hours are wall-clock facts ("we open at 9"), and a
/// timestamp would shift them across DST.
/// A one-off closure: a public holiday, a private event, a refurbishment.
///
/// Opening hours describe the repeating week and cannot express "closed on the
/// 25th". Without this a restaurant has to switch reservations off entirely
/// and remember to switch them back.
model RestaurantBlackoutDate {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Stored as YYYY-MM-DD in the restaurant's own timezone. A timestamp would
  /// shift the date across timezones for the same reason opening hours are
  /// wall-clock strings.
  date   String
  reason String?

  createdAt DateTime @default(now())

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

model RestaurantOpeningHour {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday, matching JavaScript's getDay().
  dayOfWeek Int
  /// "HH:mm", 24-hour. `closesAt` earlier than `opensAt` means the period runs
  /// past midnight into the next day (18:00–02:00), which is normal for
  /// restaurants and the main thing naive implementations get wrong.
  opensAt   String
  closesAt  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, dayOfWeek])
}

model RestaurantPayoutAccount {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  gateway   PaymentGateway
  /// Lets an owner keep a connected provider but stop offering it at checkout,
  /// without destroying the subaccount (Paystack has no delete endpoint).
  isEnabled Boolean        @default(true)

  bankCode       String
  bankName       String
  accountNumber  String
  accountName    String
  /// Provider-side subaccount that receives the settlement.
  subaccountCode String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, gateway])
  @@index([restaurantId])
}

model RestaurantBankAccount {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accountName   String
  accountNumber String
  bankName      String
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId])
}

// ─── Menu ─────────────────────────────────────────────

model RestaurantBanner {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  imageUrl     String
  title        String?
  subtitle     String?
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

model MenuCategory {
  id                String     @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  emoji             String?
  sortOrder         Int        @default(0)
  isActive          Boolean    @default(true)
  // Set when a forced Free downgrade (subscription lapsed) auto-hid this
  // category. Lets a later renewal/upgrade restore exactly the categories
  // the system hid, without also re-enabling ones the owner hid themselves
  // for unrelated reasons.
  hiddenByDowngrade Boolean    @default(false)
  items             MenuItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([restaurantId])
}

model MenuItem {
  id             String       @id @default(cuid())
  categoryId     String
  category       MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Decimal      @db.Decimal(10, 2)
  imageUrl       String?
  isAvailable    Boolean      @default(true)
  isTodaySpecial Boolean      @default(false)
  sortOrder      Int          @default(0)
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([categoryId])
}

// ─── Orders ───────────────────────────────────────────

model Order {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?

  /// Set the moment each lifecycle email is claimed, never after sending.
  ///
  /// Seven code paths can mark an order paid (Paystack webhook, the return
  /// page, staff, admin, split payments…) and several can race — a webhook and
  /// the customer landing back on the order page arrive within milliseconds of
  /// each other. Claiming the slot with a conditional UPDATE makes "send this
  /// email exactly once" a database guarantee rather than a hope.
  newOrderEmailSentAt     DateTime?
  confirmationEmailSentAt DateTime?
  receiptEmailSentAt      DateTime?
  completionEmailSentAt   DateTime?
  cancellationEmailSentAt DateTime?

  messages OrderMessage[]

  type          OrderType
  status        OrderStatus   @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)

  paymentRef      String?
  paymentProvider String?

  tableNumber         String?
  tableId             String?
  table               TableSeat?           @relation("TableOrders", fields: [tableId], references: [id])
  tableLabel          String?
  dineInPaymentPolicy PaymentPolicy?
  dineInPaymentMethod DineInPaymentMethod?
  dineInServiceMode   DineInServiceMode?
  waiterName          String?

  dineInAmountPaid        Decimal?             @db.Decimal(10, 2)
  dineInPaymentRecordedAt DateTime?
  dineInPaidMethod        DineInPaymentMethod?

  attendingStaffId String?
  attendingStaff   StaffMember? @relation("AttendingStaff", fields: [attendingStaffId], references: [id])

  deliveryAddress   String?
  deliveryNotes     String?
  statusNote        String?
  orderFor          String? // "SELF" | "SOMEONE_ELSE"
  senderPhone       String?
  senderTableNumber String?
  receiverPhone     String?
  receiverAltPhone  String?
  receiverName      String?
  seatNumber        String?
  deliveryFee       Decimal @default(0) @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  items    OrderItem[]
  payments OrderPayment[]
  events   OrderEvent[]

  whatsappNotified   Boolean   @default(false)
  whatsappNotifiedAt DateTime?

  rating Rating?

  linkedReservation Reservation? @relation("ReservationPreOrder")

  cancelledById    String?
  cancelledAt      DateTime?
  cancellationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([customerPhone])
  @@index([paymentRef])
  @@index([attendingStaffId])
}

/// One row per message actually sent to a customer about an order.
///
/// The unique key is the whole point: several code paths can move an order to
/// the same status (admin, staff, a webhook), and a customer receiving "your
/// order is ready" three times is worse than not receiving it at all.
model OrderMessage {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status      OrderStatus
  channel     CustomerUpdateChannel
  /// Provider message id, for tracing a delivery complaint back to Twilio.
  providerRef String?
  sentAt      DateTime              @default(now())

  @@unique([orderId, status])
  @@index([orderId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  qty       Int
  notes     String?

  @@index([orderId])
}

enum PaymentDirection {
  CREDIT
  REFUND
}

enum LedgerEntryStatus {
  /// Money moved and the amount matched what was owed.
  SUCCESS
  /// The gateway reported success but the amount or currency disagreed with
  /// the order. Recorded and NOT credited, so it can be investigated.
  MISMATCH
  /// Superseded by a later refund entry. The original row is never edited.
  REVERSED
}

enum SettlementStatus {
  PENDING
  SETTLED
  /// Our record and the provider's disagree — surfaced for reconciliation.
  DISPUTED
}

/// The financial ledger: one row per movement of money, append-only.
///
/// Append-only is the whole discipline. A row is never edited to reflect a
/// later event — a refund is a new REFUND row, and the original is marked
/// REVERSED. Editing a money row destroys the evidence of what it previously
/// claimed, which is exactly what an audit needs to see.
///
/// Every fee is stored as it was AT THE TIME OF PAYMENT rather than derived on
/// read. Plan percentages change; a report that recalculates last year's
/// payments at today's rate is simply wrong.
///
/// restaurantId is denormalised so financial reports can scan by restaurant and
/// date without joining through orders — the export is the main read path.
model OrderPayment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String? // E.g., Paystack ref, bank transfer ref
  recordedById String? // ID of staff or admin who recorded this
  createdAt    DateTime      @default(now())

  direction PaymentDirection  @default(CREDIT)
  status    LedgerEntryStatus @default(SUCCESS)
  currency  String            @default("NGN")

  /// Null for cash/POS/transfer taken in person.
  gateway PaymentGateway?

  /// What the order was owed when this entry was written, so a later change to
  /// the order can never make a historic entry look wrong.
  expectedAmount Decimal? @db.Decimal(10, 2)

  gatewayFee      Decimal? @db.Decimal(10, 2)
  platformFee     Decimal? @db.Decimal(10, 2)
  netToRestaurant Decimal? @db.Decimal(10, 2)
  subaccountCode  String?

  settlementStatus SettlementStatus @default(PENDING)
  settledAt        DateTime?

  /// The provider's payload verbatim. When our numbers and theirs disagree,
  /// this is the only record of what they actually said.
  rawPayload Json?

  /// Free-text reason, used by refunds.
  note String?

  @@unique([gateway, reference])
  @@index([orderId])
  @@index([restaurantId, createdAt])
  @@index([settlementStatus])
}

enum AuditActorType {
  OWNER
  STAFF
  SUPER_ADMIN
  /// A webhook or scheduled job, which has no human behind it.
  SYSTEM
  CUSTOMER
}

/// Who did what, inside one restaurant.
///
/// The platform AuditLog only covers super-admin actions, which leaves the
/// questions an owner actually asks unanswerable: who marked this cash order
/// paid, who changed the payout bank account, who cancelled this booking.
///
/// Payout changes matter most. Swapping the settlement account is the classic
/// insider-fraud path — every subsequent payment leaves quietly — so those
/// entries record the before and after values and also email the owner.
///
/// Append-only, like the ledger. Entries are never edited or deleted.
model RestaurantAuditEvent {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  actorType AuditActorType
  /// Null for SYSTEM. Staff id, user id, or super-admin id otherwise.
  actorId   String?
  /// Captured at write time: staff get deleted, and "who did this" must still
  /// answer years later.
  actorName String

  /// Dotted and stable, e.g. "payment.recorded", "payout.account_changed".
  action String
  /// Human-readable target, e.g. "Order #A12F" — safe to show in a UI.
  target String

  /// Only set where the before/after matters, as with payout details.
  previousValue String?
  newValue      String?

  /// Kept for security questions ("who was this, and from where").
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
}

// ─── Tables & Reservations ────────────────────────────

model ReservationSetting {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// How far ahead a customer may book. Genuinely restaurant-wide.
  advanceBookingHours Int @default(0)

  /// Bookings land on a grid rather than any minute the customer types. A raw
  /// time input let people book 19:37, which no kitchen can pace around and
  /// which makes the overlap arithmetic close to meaningless.
  slotIntervalMinutes Int @default(30)

  /// How long a table is held past the booking time before it is released to
  /// walk-ins. Distinct from the booking length: this is the no-show window.
  graceMinutes Int @default(15)

  /// Confirm free bookings without anyone pressing accept. Only ever applied
  /// once the table is verified free for the slot — an auto-confirmed double
  /// booking is worse than a wait.
  autoConfirmFreeBookings Boolean @default(false)
  /// Shown to the customer before they commit money. Previously stored but
  /// never rendered on the public booking page, which is the most serious gap
  /// in this flow — people were paying deposits with no stated terms.
  cancellationPolicy      String?
  refundPolicy            String?
  /// Free-text note shown on the public booking page.
  bookingDescription      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TableSeat {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  label       String
  description String?
  imageUrl    String?
  capacity    Int     @default(2)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Booking rules live on the table, not the restaurant: a window seat for
  /// two and a private room for twelve do not share a hold time, a minimum
  /// spend, or whether food is required. The old restaurant-wide defaults plus
  /// per-table overrides said the same thing in two places and could disagree.
  bookingMode   TableBookingMode   @default(FREE_BOOKING)
  paymentTiming TablePaymentTiming @default(PAY_ON_ARRIVAL)
  inclusionType TableInclusionType @default(TABLE_FEE_ONLY)

  /// How long the table is held before an unconfirmed booking expires.
  holdMinutes  Int @default(60)
  minPartySize Int @default(1)
  /// 0 means "up to capacity".
  maxPartySize Int @default(0)

  /// Percentage of the booking total taken up front when bookingMode is
  /// DEPOSIT_REQUIRED. 0 falls back to charging the table fee alone, which is
  /// what "deposit" used to mean here — a flat fee, unrelated to the total.
  depositPercent Int @default(0)

  tableFee     Decimal? @db.Decimal(10, 2)
  minimumSpend Decimal? @db.Decimal(10, 2)

  reservations Reservation[]
  orders       Order[]       @relation("TableOrders")

  @@index([restaurantId])
}

model Reservation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  tableId      String
  table        TableSeat  @relation(fields: [tableId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?
  partySize     Int     @default(1)

  startsAt  DateTime
  endsAt    DateTime?
  expiresAt DateTime
  status    ReservationStatus @default(PENDING_APPROVAL)

  qstashMessageId String?
  approvedAt      DateTime?
  declinedAt      DateTime?
  declineReason   String?

  effectiveBookingMode    TableBookingMode
  effectivePaymentTiming  TablePaymentTiming
  effectiveInclusionType  TableInclusionType
  /// Snapshot, like the other effective* fields: the terms agreed at booking
  /// time must not change if the table is edited afterwards.
  effectiveDepositPercent Int                @default(0)

  effectiveTableFee Decimal? @db.Decimal(10, 2)

  reservationPaymentStatus PaymentStatus @default(PENDING)
  reservationPaymentRef    String?
  reservationAmountPaid    Decimal?      @db.Decimal(10, 2)

  preOrderId String? @unique
  preOrder   Order?  @relation("ReservationPreOrder", fields: [preOrderId], references: [id])

  specialRequests String?

  /// Claimed with a conditional UPDATE before sending, exactly like the order
  /// emails. Several paths can confirm one reservation — the customer returning
  /// from Paystack, the webhook, an owner approving it by hand — and a guest
  /// receiving "your table is confirmed" three times reads as a broken system.
  requestedEmailSentAt DateTime?
  confirmedEmailSentAt DateTime?
  declinedEmailSentAt  DateTime?
  cancelledEmailSentAt DateTime?
  reminderEmailSentAt  DateTime?

  rating Rating?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([tableId])
  @@index([startsAt])
  @@index([customerPhone])
}

// ─── Customer Access ─────────────────────────────────

model CustomerProfile {
  id               String  @id @default(cuid())
  fullName         String?
  whatsappNumber   String? @unique
  alternativePhone String?
  email            String? @unique
  deliveryAddress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsappNumber])
  @@index([email])
}

model CustomerOtp {
  id         String    @id @default(cuid())
  identifier String
  channel    String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
}

// ─── In-App Notifications ─────────────────────────────
//
// One Notification row is written per event per restaurant.
// Read status is tracked per-recipient via NotificationRead.
// Recipients are either the restaurant owner (admin) or staff members.
//
// Flow:
//   1. Event fires (new order, status change, etc.)
//   2. createNotification() writes a Notification row
//   3. dispatchNotification() publishes to Redis pub/sub channel
//      → SSE streams pick it up and push to connected clients
//   4. sendWebPush() sends to all stored VAPID subscriptions for
//      the restaurant's admin and/or staff (if PWA installed)
//   5. Client receives event, Zustand store increments unread count,
//      NotificationBell shows badge

model Notification {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  type     NotificationType
  audience NotificationAudience // Who should receive this

  title String // Short heading, e.g. "New Order #A3F2"
  body  String // Detail line, e.g. "Dine-in · Table 5 · ₦4,500"

  // Optional deep-link — where clicking the notification navigates to
  // e.g. "/dashboard/burgerpalace/orders?orderId=xxx"
  actionUrl String?

  // Contextual data (orderId, reservationId, etc.) stored as JSON
  // Used by the client to update local state without a refetch
  metadata Json?

  reads NotificationRead[]

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, audience])
}

// Per-recipient read tracking.
// recipientType: "admin" = User (restaurant owner), "staff" = StaffMember

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  recipientType String // "admin" | "staff"
  recipientId   String // userId (admin) or staffMemberId (staff)

  readAt DateTime @default(now())

  @@unique([notificationId, recipientType, recipientId])
  @@index([recipientType, recipientId])
}

// VAPID Web Push subscriptions — stored per recipient so we can
// send to all devices a user/staff member has installed the PWA on.

model PushSubscription {
  id String @id @default(cuid())

  // Belongs to either a User (admin) or StaffMember — not both
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  restaurantId String // Denormalised for easy querying by tenant

  // The Web Push subscription object from the browser
  endpoint String @unique
  p256dh   String // Public key
  auth     String // Auth secret

  userAgent String?
  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([userId])
  @@index([staffMemberId])
}

// ─── Ratings ──────────────────────────────────────────

model Rating {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  orderId       String?      @unique
  order         Order?       @relation(fields: [orderId], references: [id])
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  context RatingContext

  foodQuality    Int?
  deliverySpeed  Int?
  packaging      Int?
  serviceQuality Int?
  ambiance       Int?
  valueForMoney  Int?
  overallRating  Int

  comment  String?
  isHidden Boolean @default(false)

  customerName  String?
  customerPhone String?

  createdAt DateTime @default(now())

  @@index([restaurantId])
}

// ─── Analytics ────────────────────────────────────────

model ScanEvent {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  scannedAt    DateTime   @default(now())
  userAgent    String?
  country      String?

  @@index([restaurantId, scannedAt])
}

// ─── Order Events ─────────────────────────────────────

model OrderEvent {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  staffId     String?
  staff       StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  isAutomatic Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([staffId])
}

// ─── Super Admin ──────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  target    String
  status    String   @default("success")
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model PlatformSetting {
  id                String  @id @default(cuid())
  platformName      String  @default("AwaMenu")
  logoUrl           String?
  paystackPublicKey String?
  paystackSecretKey String?
  maintenanceMode   Boolean @default(false)

  // Percentage AwaMenu takes from each AwaMenu Pay order, on top of the
  // provider's own fee. Defaults to 0 — restaurants keep everything except the
  // gateway fee — but is adjustable here without a deploy.
  awamenuPayCommissionPercent Decimal @default(0) @db.Decimal(5, 2)

  // ─── What restaurants are allowed to offer ───
  // These are the platform's shop window. A channel or provider left out here
  // disappears from every restaurant's settings AND is refused server-side, so
  // a provider having a bad week can be pulled without a deploy, and a new one
  // can be rolled out once its credentials are in place.
  //
  // Removing one does not disconnect restaurants already using it — their
  // subaccounts survive; the option simply stops being offered.
  enabledPaymentChannels PaymentChannel[] @default([AWAMENU_PAY, OWN_GATEWAY, BANK_TRANSFER, CASH])

  /// Providers offered under AwaMenu Pay. Still gated by whether the platform
  /// actually holds credentials for them — this can only narrow that set.
  awamenuPayProviders PaymentGateway[] @default([PAYSTACK, MONNIFY])

  /// Providers a restaurant may connect with their own keys.
  ownGatewayProviders PaymentGateway[] @default([PAYSTACK, FLUTTERWAVE, MONNIFY])

  updatedAt DateTime @updatedAt
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
}
